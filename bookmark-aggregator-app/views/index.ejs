<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
</head>
<body>
  <h1><%= title %></h1>

  <% if (user) { %>
    <p>Welcome, <%= user.displayName %>!</p>
    <a href="/profile">Profile</a>
    <a href="/auth/logout">Logout</a>
  <% } else { %>
    <a href="/auth/google">Login with Google</a>
  <% } %>

</body>
</html>
